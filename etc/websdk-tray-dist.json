{
    "label": "Web SDK",
    "autostart": false,
    "waitBetweenProcesses": 1,
    "menu": [
        {
            "name": "httpd",
            "label": "Démarrer WebSdk[apache|mariadb]",
            "notify": [
                "Démarrage du WebSdk [apache|mariadb]"
            ],
            "start": [
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/start-httpd.bat"
            ],
            "checks": {
                "process": [
                    "httpd.exe"
                ]
            },
            "visible": [
                "mariadb"
            ]
        },
        {
            "name": "on",
            "label": "Démarrer WebSdk[nginx|php8.4|mariadb]",
            "notify": [
                "Démarrage du WebSdk [nginx|php8.4|mariadb]"
            ],
            "start": [
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/start-cgi.bat",
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/start-nginx.bat"
            ],
            "checks": {
                "process": [
                    "nginx.exe",
                    "php-cgi.exe"
                ]
            },
            "visible": [
                "mariadb"
            ]
        },
        {
            "name": "httpd-postgres",
            "label": "Démarrer WebSdk[apache|postgres]",
            "notify": [
                "Démarrage du WebSdk [apache|postgres]"
            ],
            "start": [
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/start-httpd.bat"
            ],
            "checks": {
                "process": [
                    "httpd.exe"
                ]
            },
            "visible": [
                "pg"
            ]
        },
        {
            "name": "httpd-mariadb",
            "label": "Démarrer WebSdk[apache|mariadb]",
            "notify": [
                "Démarrage du WebSdk [apache|mariadb]"
            ],
            "start": [
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/start-mariadb.bat",
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/start-httpd.bat"
            ],
            "checks": {
                "process": [
                    "mariadbd.exe",
                    "httpd.exe"
                ]
            },
            "icons": [
                "icons/on.png",
                "icons/dark/on.png"
            ],
            "visible": [
                "!mariadb"
            ]
        },
        {
            "name": "on-mariadb",
            "label": "Démarrer WebSdk[nginx|php8.4|mariadb]",
            "notify": [
                "Démarrage du WebSdk [nginx|php8.4|mariadb]"
            ],
            "start": [
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/start-mariadb.bat",
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/start-cgi.bat",
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/start-nginx.bat"
            ],
            "checks": {
                "process": [
                    "mariadbd.exe",
                    "nginx.exe",
                    "php-cgi.exe"
                ]
            },
            "icons": [
                "icons/on.png",
                "icons/dark/on.png"
            ],
            "visible": [
                "!mariadb"
            ]
        },
        {
            "name": "on-httpd-postgres",
            "label": "Démarrer WebSdk[apache|postgres]",
            "notify": [
                "Démarrage du WebSdk [apache|postgres]"
            ],
            "start": [
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/start-pg.bat",
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/start-httpd.bat"
            ],
            "checks": {
                "process": [
                    "postgres.exe",
                    "httpd.exe"
                ]
            },
            "icons": [
                "icons/on.png",
                "icons/dark/on.png"
            ],
            "visible": [
                "!pg"
            ]
        },
        {
            "name": "off",
            "label": "Arrêter WebSdk",
            "notify": [
                "Arrêt du WebSdk"
            ],
            "start": [
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/stop-httpd.bat",
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/stop-nginx.bat",
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/stop-cgi.bat",
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/stop-mariadb.bat",
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/stop-pg.bat"
            ],
            "icons": [
                "icons/off.png",
                "icons/dark/off.png"
            ]
        },
        "separator",
        {
            "name": "php-info",
            "label": "Afficher informations PHP",
            "start": [
                "cmd.exe /C start  http://localhost/adminer/info.php"
            ],
            "visible": [
                "!off",
                "adm-enabled"
            ]
        },
        {
            "name": "cgi-conf",
            "label": "Changer nginx PHP version",
            "notify": [
                "Modifier la version de php et reDémarrer le WebSDK"
            ],
            "start": [
                "notepad.exe C:\\WebSdk\\etc\\php-cgi.bat"
            ],
            "visible": [
                "on-mariadb"
            ]
        },
        {
            "name": "httpd-conf",
            "label": "Configurer Apache",
            "notify": [
                "Ajoutez des alias, virtual hosts ou changez la version de PHP"
            ],
            "start": [
                "explorer.exe C:\\WebSdk\\lib\\httpd\\conf\\custom"
            ],
            "visible": [
                "httpd-mariadb"
            ]
        },
        {
            "name": "adm",
            "label": "Démarrer Adminer",
            "start": [
                "cmd.exe /C start  https://localhost/adminer/?server=MySql&username=root"
            ],
            "visible": [
                "!off",
                "adm-enabled"
            ]
        },
        {
            "name": "pma",
            "label": "Démarrer PhpMyAdmin",
            "start": [
                "cmd.exe /C start  http://localhost/phpmyadmin/index.php?route=/"
            ],
            "visible": [
                "!off",
                "pma-enabled"
            ]
        },
        "separator",
        {
            "name": "mariadb-console",
            "label": "Console MariaDB",
            "notify": [
                "Accès à la console MariaDB"
            ],
            "start": [
                "cmd.exe /C C:/WebSdk/lib/mariadb/console.bat"
            ],
            "visible": [
                "mariadb"
            ]
        },
        "separator",
        {
            "name": "redis",
            "label": "Démarrer Redis",
            "notify": [
                "Lancement de Redis",
                "Arrêt de Redis"
            ],
            "start": [
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/start-redis.bat"
            ],
            "stop": [
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/stop-redis.bat"
            ],
            "checks": {
                "process": [
                    "redis-server.exe"
                ]
            }
        },
        "separator",
        {
            "name": "pg-sql",
            "label": "Démarrer PostgreSql",
            "notify": [
                "Lancement de PostgreSql",
                "Arrêt de PostgreSql"
            ],
            "start": [
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/start-pg.bat"
            ],
            "stop": [
                "cmd.exe /C C:/WebSdk/lib/sdk/scripts/stop-pg.bat"
            ],
            "checks": {
                "process": [
                    "postgres.exe"
                ]
            }
        },
        {
            "name": "pg-console",
            "label": "Console PostgreSql",
            "notify": [
                "Accès à la console PostgreSql"
            ],
            "start": [
                "cmd.exe /C C:/WebSdk/lib/pg/console.bat"
            ],
            "visible": [
                "pg"
            ]
        },
        {
            "name": "adm-enabled",
            "label": "adm-enabled",
            "visible": false,
            "checks": {
                "files": [
                    "c:/WebSdk/var/www/adminer/adminer.php"
                ]
            }
        },
        {
            "name": "pma-enabled",
            "label": "pma-enabled",
            "visible": false,
            "checks": {
                "files": [
                    "c:/WebSdk/var/www/PhpMyAdmin/index.php"
                ]
            }
        },
        {
            "name": "redis-on",
            "label": "redis-on",
            "visible": false,
            "checks": {
                "process": [
                    "redis-server.exe"
                ]
            }
        },
        {
            "name": "pg",
            "label": "pg",
            "visible": false,
            "checks": {
                "process": [
                    "postgres.exe"
                ]
            }
        },
        {
            "name": "mariadb",
            "label": "mariadb",
            "visible": false,
            "checks": {
                "process": [
                    "mariadbd.exe"
                ]
            }
        }
    ],
    "labels": {
        "Exit": "Quitter",
        "Auto Start": "Démarrage automatique"
    }
}